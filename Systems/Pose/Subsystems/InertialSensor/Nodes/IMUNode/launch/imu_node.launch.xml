<?xml version="1.0" encoding="UTF-8"?>
<!-- @compare_tag Node-Launch v0.1 -->
<launch>
    <arg name="robot_namespace" default="/"/> 
    <arg name="verbosity_level" default="INFO" description="Logging level (DEBUG,INFO,NOTICE,WARN,ERROR,FATAL)"/>
    <arg name="node_name" default="imu_node" description="Name of the node at runtime"/>
    <arg name="node_namespace" default="pose/inertial_sensor/imu" description="Runtime namespace for the node"/>
    <arg name="sensor" default="" description="The active sensor filename to load"/>
    <arg name="target_frame" default="base_link" description="Frame used by published IMU messages"/>
    <arg name="imu_topic" default="imu" description="IMU topic name"/>
    <arg name="accel_topic" default="accel" description="Acceleration topic name"/>
    <arg name="magnetic_topic" default="magnetic" description="Magnetic field topic name"/>
    <arg name="sensor_config_package" default="robot_framework_ros2"/>
    <arg name="sensor_config_relative_path" default="config/Fake_IMU_Device.yaml"/>
    <let name="hw_config" value="$(find-pkg-share $(var sensor_config_package))/$(var sensor_config_relative_path)"/>
    
    <group>
        <push-ros-namespace namespace="$(var robot_namespace)"/>
        <node pkg="robot_framework_ros2" 
            exec="imu_node" 
            name="$(var node_name)" 
            namespace="$(var node_namespace)"
            output="screen"  
            emulate_tty="true">
            <param name="robot_namespace" value="$(var robot_namespace)"/>
            <param name="node_namespace" value="$(var node_namespace)"/>
            <param name="sensor" value="$(var sensor)"/>
            <param name="target_frame" value="$(var target_frame)"/>
            <param name="imu_topic" value="$(var imu_topic)"/>
            <param name="accel_topic" value="$(var accel_topic)"/>
            <param name="magnetic_topic" value="$(var magnetic_topic)"/>
            <param from="$(find-pkg-share robot_framework_ros2)/Systems/Pose/config/config.yaml"/>
            <param from="$(var hw_config)"/>
            <param name="verbosity_level" value="$(var verbosity_level)"/>
            <param name="loop1_rate" value="200.0"/> <!-- General Update -->
            <param name="loop2_rate" value="200.0"/> <!-- Publish IMU Data -->
        </node>
    </group>
</launch>
