<?xml version="1.0" encoding="UTF-8"?>
<!-- @compare_tag Node-Launch v0.2 -->
<launch>
    <arg name="robot_namespace" default="/"/> 
    <arg name="verbosity_level" default="INFO" description="Logging level (DEBUG,INFO,NOTICE,WARN,ERROR,FATAL)"/>
    <arg name="node_name" default="depthcamera_pipeline_node" description="Name of the node at runtime"/>
    <arg name="node_namespace" default="perception/depthcamerapipeline" description="Runtime namespace for the node"/>
    <arg name="sensor1_depthcamera_topic" default="camera/depth" description="Sensor 1 Depth Camera Input Topic"/>
    <arg name="fused_depthcamera_topic" default="fused_depth" description="Fused Depth Camera Topic"/>
    <group>
        <push-ros-namespace namespace="$(var robot_namespace)"/>
        <node pkg="robot_framework_ros2" 
            exec="depthcamera_pipeline_node" 
            name="$(var node_name)" 
            namespace="$(var node_namespace)"
            output="screen"  
            emulate_tty="true">
            <param from="$(find-pkg-share robot_framework_ros2)/Systems/Perception/config/config.yaml"/>
            <param name="robot_namespace" value="$(var robot_namespace)"/>
            <param name="node_namespace" value="$(var node_namespace)"/>
            <param name="verbosity_level" value="$(var verbosity_level)"/>
            <param name="sensor1_depthcamera_topic" value="$(var sensor1_depthcamera_topic)"/>
            <param name="fused_depthcamera_topic" value="$(var fused_depthcamera_topic)"/>
            <param name="loop1_rate" value="20.0"/> <!-- General Process Update -->
        </node>
    </group>
</launch>
