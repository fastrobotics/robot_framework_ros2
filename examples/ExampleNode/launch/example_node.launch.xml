<?xml version="1.0" encoding="UTF-8"?>
<!-- @compare_tag Node-Launch v0.2 -->
<launch>
    <arg name="robot_namespace" default="/"/> 
    <arg name="verbosity_level" default="INFO" description="Logging level (DEBUG,INFO,NOTICE,WARN,ERROR,FATAL)"/>
    <arg name="node_name" default="example_node" description="Name of the node at runtime"/>
    <arg name="node_namespace" default="example/example/example" description="Runtime namespace for the node"/>
    <group>
        <push-ros-namespace namespace="$(var robot_namespace)"/>
        <node pkg="robot_framework_ros2" 
            exec="example_node" 
            name="$(var node_name)" 
            namespace="$(var node_namespace)"
            output="screen"  
            emulate_tty="true">
            <param from="$(find-pkg-share robot_framework_ros2)/Systems/Example/config/config.yaml"/>
            <param name="robot_namespace" value="$(var robot_namespace)"/>
            <param name="node_namespace" value="$(var node_namespace)"/>
            <param name="verbosity_level" value="$(var verbosity_level)"/>
            <param name="loop1_rate" value="1.0"/>
            <param name="loop2_rate" value="2.0"/>
            <param name="loop3_rate" value="3.0"/>
        </node>
    </group>
</launch>
