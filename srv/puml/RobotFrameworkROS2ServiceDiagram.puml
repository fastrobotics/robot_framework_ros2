@startuml
title Robot Framework ROS2 Service Diagram
package robot_framework_ros2 #LightYellow;line:blue {
    class ArmStateChange <<(M,#FFFF00)>> <<ROS>> #LimeGreen {
        +ArmedState requested_armed_state
        ---
        +ArmedState current_armed_state
        +bool request_approved
    }
    ArmStateChange --> ArmedState: <<use>>
    class ChangeLoggerLevel <<(M,#FFFF00)<< <<ROS2>> #Orange {
        +uint8 verbosity_level
        ---
        +bool request_approved
    }

}
@enduml