<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="robot_namespace" default="/"/> 
    <arg name="verbosity_level" default="INFO" description="Logging level (DEBUG,INFO,NOTICE,WARN,ERROR,FATAL)"/>
    <arg name="node_name" default="{{cookiecutter.NodeBinary}}" description="Name of the node at runtime"/>
    <let name="config_path" value="$(find-pkg-share robot_framework_ros2)/config/{{cookiecutter.NodeBinary}}_config.yaml"/>
    <group>
        <push-ros-namespace namespace="$(var robot_namespace)"/>
        <node pkg="robot_framework_ros2" 
            exec="{{cookiecutter.NodeBinary}}" 
            name="$(var node_name)" 
            namespace="{{cookiecutter.System|lower}}/{{cookiecutter.Subsystem|lower}}/{{cookiecutter.Process|lower}}" 
            output="screen"  
            emulate_tty="true">
            <param from="$(var config_path)"/>
            <param name="verbosity_level" value="$(var verbosity_level)"/>
            <param name="loop1_rate" value="1.0"/>
            <param name="loop2_rate" value="2.0"/>
            <param name="loop3_rate" value="3.0"/>
        </node>
    </group>
</launch>
